# Caddy sits in front of everything and is the only thing on the internet.
# It terminates TLS (Let's Encrypt, obtained and renewed automatically) and
# proxies WebSocket upgrades with no extra configuration.
#
# SITE_ADDRESS drives the certificate. Until a real domain exists, an
# sslip.io name (e.g. 51-250-17-150.sslip.io) resolves to the server's IP and
# Let's Encrypt will issue for it — real HTTPS with nothing purchased. Swapping
# to a bought domain later is a one-line change plus a reload.

# No global options block on purpose. `email {$ACME_EMAIL}` is a parse error
# when the variable is empty — an unset directive is invalid, not a no-op — and
# it crash-loops the whole proxy. Caddy obtains certificates perfectly well
# without a contact address; add one deliberately if you want expiry notices.

{$SITE_ADDRESS} {
	encode gzip

	log {
		output stdout
		format console
	}

	# ---- admin surface -------------------------------------------------
	# No basic auth and no injected token any more. The dashboard signs in as a
	# real administrator through /auth/*, holds that session itself, and sends
	# its own bearer token — so the browser can show who is signed in, expire
	# the session, and sign out. Authorisation stays where it belongs: every
	# /admin endpoint checks for the admin role in the service.
	@admin path /admin/* /api/admin/*
	handle @admin {
		uri strip_prefix /api
		reverse_proxy gateway:8080
	}

	# ---- the iOS app's surface ------------------------------------------
	@api path /auth/* /users/* /orders /orders/* /wallet/* \
		/notifications /notifications/* /reviews /reviews/* \
		/ws /health /health/*
	handle @api {
		reverse_proxy gateway:8080
	}

	# The dashboard calls /api/* by convention (same as the Vite dev proxy),
	# so strip the prefix and forward. Admin paths were already handled above.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy gateway:8080
	}

	# ---- the dashboard ---------------------------------------------------
	# Static SPA, served publicly — it is a login screen, and it holds no data
	# until somebody signs in. try_files sends unknown paths to index.html so
	# client-side routing works.
	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}
}
