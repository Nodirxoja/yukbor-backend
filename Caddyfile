# Caddy sits in front of everything and is the only thing on the internet.
# It terminates TLS (Let's Encrypt, obtained and renewed automatically) and
# proxies WebSocket upgrades with no extra configuration.
#
# SITE_ADDRESS drives the certificate and may list SEVERAL names, comma or
# space separated — Caddy obtains a certificate for each and serves the same
# site on all of them. Listing the old name alongside the new one means a
# rename is never a cutover: nothing that already works stops working.
#
# Until a real domain is bought, an sslip.io name (51-250-17-150.sslip.io)
# resolves to the server's IP and Let's Encrypt issues for it, and a free
# DuckDNS name gives something readable. Both are somebody else's domain, so
# buy yukbor.uz before real users — that is the same one-line change again.

# No global options block on purpose. `email {$ACME_EMAIL}` is a parse error
# when the variable is empty — an unset directive is invalid, not a no-op — and
# it crash-loops the whole proxy. Caddy obtains certificates perfectly well
# without a contact address; add one deliberately if you want expiry notices.

# Serving the dashboard: repeated in three places below, so it is a snippet.
(spa) {
	root * /srv/dashboard
	# {path}/index.html so /docs resolves to the API reference; /index.html
	# last so every unknown path falls through to the SPA's own router.
	try_files {path} {path}/index.html /index.html
	file_server
}

{$SITE_ADDRESS} {
	encode gzip

	log {
		output stdout
		format console
	}

	# ---- who is asking ---------------------------------------------------
	# /orders and /users/* are BOTH API endpoints and dashboard routes: the app
	# GETs /orders for JSON, while an operator opening /orders/{id} in a browser
	# wants the page. The path alone cannot tell them apart, so the request has
	# to — and a browser NAVIGATION is unmistakable.
	#
	# Sec-Fetch-Mode: navigate is sent by every current browser on a top-level
	# navigation and by no API client. Accept: text/html is the fallback for
	# anything older. Neither is sent by URLSession, fetch(), or curl, so the
	# mobile app keeps getting JSON from exactly the same URLs.
	@browserNavigation {
		path /orders /orders/* /users /users/*
		header Sec-Fetch-Mode navigate
	}
	handle @browserNavigation {
		import spa
	}

	@browserAccept {
		path /orders /orders/* /users /users/*
		header Accept *text/html*
	}
	handle @browserAccept {
		import spa
	}

	# ---- admin surface ---------------------------------------------------
	# No basic auth and no injected token. The dashboard signs in as a real
	# administrator through /auth/*, holds that session itself, and sends its
	# own bearer token — so the browser can show who is signed in, expire the
	# session, and sign out. Authorisation stays where it belongs: every /admin
	# endpoint checks for the admin role in the service.
	@admin path /admin/* /api/admin/*
	handle @admin {
		uri strip_prefix /api
		reverse_proxy gateway:8080
	}

	# ---- the iOS app's surface -------------------------------------------
	@api path /auth/* /users /users/* /orders /orders/* /wallet/* \
		/notifications /notifications/* /reviews /reviews/* \
		/ws /health /health/*
	handle @api {
		reverse_proxy gateway:8080
	}

	# The dashboard calls /api/* by convention (same as the Vite dev proxy), so
	# strip the prefix and forward. This is why the dashboard's own data
	# requests never collide with the routes above: they are all under /api.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy gateway:8080
	}

	# ---- the dashboard ---------------------------------------------------
	# Static SPA, served publicly — it is a login screen, and it holds no data
	# until somebody signs in. try_files sends unknown paths to index.html so
	# client-side routing works.
	handle {
		import spa
	}
}
